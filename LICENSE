import express, { Request, Response, NextFunction } from 'express';
import cors from 'cors';
import helmet from 'helmet';
import rateLimit from 'express-rate-limit';
import { createServer } from 'http';
import { Server as SocketIOServer } from 'socket.io';

// =========================================================
// SECTION 1: GLOBAL SERVER CONSTANTS & INITIALIZATION Matrix
// =========================================================
const APP_PORT = process.env.PORT || 9000;
const app = express();
const httpServer = createServer(app);
const io = new SocketIOServer(httpServer, {
    cors: { origin: "*", methods: ["GET", "POST"] }
});

// High-Density Security Systems & Rate Limit Gateways
app.use(helmet());
app.use(cors());
app.use(express.json());

const apiLimiter = rateLimit({
    windowMs: 15 * 60 * 1000, // 15 minutes window bounds
    max: 1000, // Hardcap token constraints per client profile
    message: { error: "TOO_MANY_REQUESTS", trace: "GATEWAY_LIMIT_REACHED" }
});

// =========================================================
// SECTION 2: PRODUCTION AGENTIC INTERACTIVE ROUTING APIS
// =========================================================
interface PromptPayload {
    prompt: string;
    temperature: number;
    topP: number;
    modelNode: string;
}

app.post('/api/v1/matrix/compile', apiLimiter, (req: Request, res: Response): void => {
    const { prompt, temperature, topP, modelNode } = req.body as PromptPayload;

    if (!prompt) {
        res.status(400).json({ status: "ERROR", code: "EMPTY_PROMPT_PAYLOAD" });
        return;
    }

    // Heuristic Threat Simulation Verification Checks Layer
    const hasJailbreakPattern = /ignore previous instructions|dan mode/i.test(prompt);
    
    if (hasJailbreakPattern) {
        res.status(422).json({
            status: "MITIGATED",
            category: "JAILBREAK_DETECT",
            threatRating: "98.92% CRITICAL",
            responseAction: "Node Blocked: Session Terminated Instantly"
        });
        return;
    }

    // Projected Performance Layout Matrix Optimization Response
    res.status(200).json({
        status: "SUCCESS",
        traceId: `tr_${Math.random().toString(16).substring(2, 10)}_gateway`,
        telemetry: {
            inputTokens: Math.floor(prompt.length / 4),
            latencyImpact: `${Math.floor(Math.random() * 50) + 40}ms`,
            efficiencyRating: "99.2% Accuracy",
            selectedCluster: modelNode || "AITECH-Neural-100B-Ultra"
        }
    });
});

// =========================================================
// SECTION 3: REAL-TIME WEBSOCKET TELEMETRY EVENTS MONITOR
// =========================================================
io.on('connection', (socket) => {
    console.log(`[INFRASTRUCTURE NODE CONNECTED]: Cluster Channel Session -> ${socket.id}`);
    
    // Asynchronous simulated stream broadcasting server optimization metrics updates
    const telemetryInterval = setInterval(() => {
        socket.emit('telemetry_tick', {
            timestamp: new Date().toISOString(),
            activeThreads: Math.floor(Math.random() * (2500 - 2300) + 2300),
            shardStatus: "OPTIMAL",
            offsetVal: `${(Math.random() * 0.005).toFixed(5)} ms`
        });
    }, 4000);

    socket.on('disconnect', () => {
        clearInterval(telemetryInterval);
        console.log(`[NODE DISCONNECTED]: Session Closed -> ${socket.id}`);
    });
});

// Global Fallback Error Interceptor Pipeline
app.use((err: Error, req: Request, res: Response, next: NextFunction) => {
    console.error(`[CRITICAL HARDWARE FAILURE]: ${err.stack}`);
    res.status(500).json({ error: "INTERNAL_GATEWAY_TERMINATED", code: "ERR_CORE_CRASH" });
});

// Launch High-Throughput Cluster Platform Engine
httpServer.listen(APP_PORT, () => {
    console.log(`\n=========================================================`);
    console.log(`AITECHMASTER CLUSTER SERVER ACTIVE ON PORT // :${APP_PORT}`);
    console.log(`STATUS REGISTRY PROTOCOLS INITIALIZED // STANDBY FOR SYNAPSE`);
    console.log(`=========================================================\n`);
});
